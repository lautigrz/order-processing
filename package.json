{
  "name": "system-order-processing",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:orders": "nest build orders-service",
    "build:payment": "nest build payment-service",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:orders": "tsx watch apps/orders-service/src/main.ts",
    "start:payment": "tsx watch apps/payment-service/src/main.ts",
    "start:inventory": "tsx watch apps/inventory-service/src/main.ts",
    "start:orders:prod": "node dist/apps/orders-service/apps/orders-service/src/main.js",
    "start:payment:prod": "node dist/apps/payment-service/apps/payment-service/src/main.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "db:clean": "node prisma/clean.mjs",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "load:smoke": "node load-tests/autocannon/run.mjs smoke",
    "load:load": "node load-tests/autocannon/run.mjs load",
    "load:stress": "node load-tests/autocannon/run.mjs stress",
    "load:readonly": "node load-tests/autocannon/run.mjs readonly",
    "load:monitor": "node load-tests/autocannon/monitor.mjs",
    "k6:smoke": "k6 run load-tests/k6/smoke.js",
    "k6:load": "k6 run load-tests/k6/load.js",
    "k6:stress": "k6 run load-tests/k6/stress.js",
    "k6:spike": "k6 run load-tests/k6/spike.js",
    "k6:e2e": "k6 run load-tests/k6/pipeline-e2e.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.10",
    "dotenv": "^18.0.5",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autocannon": "^8.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}