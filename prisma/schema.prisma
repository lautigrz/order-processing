generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     Int     @id @default(autoincrement())
  name   String
  orders Order[]

  @@map("users")
}

model Order {
  id                     Int               @id @default(autoincrement())
  customerId             Int
  total                  Decimal
  status                 Status            @default(PENDING)
  paymentStatus          PaymentStatus     @default(PENDING)
  stockReservationStatus ReservationStatus @default(PENDING)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt()

  user              User               @relation(fields: [customerId], references: [id])
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@map("orders")
}

model Product {
  id                Int                @id @default(autoincrement())
  name              String
  price             Decimal
  stock             Int                @default(0)
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@map("products")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("orderItems")
}

enum Status {
  PENDING
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REFUNDING_PENDING
}

model ProcessedEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  topic       String
  processedAt DateTime @default(now())

  @@map("processedEvents")
}

model OutboxEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique
  eventType   String
  topic       String
  payload     Json
  publishedAt DateTime?

  @@map("outboxEvents")
}

model StockReservation {
  id        Int               @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("stockReservations")
}

enum ReservationStatus {
  PENDING
  RESERVED
  RELEASED
}
